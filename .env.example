# ==============================================================================
# Intelligence Hub - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env.local for local development.
# NEVER commit actual secrets, API keys, or service-role keys to source control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Required for Phase 3: DB & Authentication)
# ------------------------------------------------------------------------------
# Public Supabase URL for client and server queries
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (safe for browser with Row Level Security enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT/BROWSER)
# Used only in secure server-side cron or admin operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# Ingestion & Discovery Feeds (Phase 4: Permitted Content Collection)
# ------------------------------------------------------------------------------
# Comma-separated list of approved RSS feed endpoints with documented permissions
PERMITTED_RSS_FEEDS=https://example.gov/feed.xml,https://example.edu/news/rss

# Maximum records processed per ingestion cycle to prevent rate-limit exhaustion
INGESTION_BATCH_SIZE=25

# User Agent identifying our platform for transparent feed collection
INGESTION_USER_AGENT=IntelligenceHubBot/1.0 (+https://example.com/bot-info)
